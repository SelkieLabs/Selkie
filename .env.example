# Selkie API. Copy to .env at the repo root; it is gitignored.
# Every value is read once at boot, so a missing one fails on start rather than
# in the middle of somebody's payment.

# --- Sign-in (Privy) ------------------------------------------------------
# Both come from the Privy dashboard: Settings > Basics.
# The secret authenticates Selkie to Privy. It is not the same thing as the app
# id, and it never belongs in the frontend.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- Stellar --------------------------------------------------------------
# Pays every fee and every account reserve, so no user ever needs XLM. Fund it
# on testnet at https://friendbot.stellar.org?addr=<its public address>.
# Whoever holds this secret can spend that account. Treat it like a bank card.
SELKIE_SPONSOR_SECRET=

# Attests logins to the escrow contract. Its only power is releasing money to
# the handle that proved it owns it, so it is the one key that must match what
# the deployed contract was told to trust.
SELKIE_ORACLE_SECRET=

# --- Optional -------------------------------------------------------------
# testnet (default) or public. Nothing else in the payment path branches on it.
SELKIE_NETWORK=testnet

# The escrow contract. Leave it unset and the API reads whatever
# contracts/deployments/<network>.env recorded at deploy time, which is what
# you want unless you are testing a contract you deployed yourself.
# SELKIE_HANDLE_ESCROW_ID=

# The port the API listens on. The web app expects 4000.
# PORT=4000

# How often to look for money arriving for somebody who is already signed in.
# One RPC call for the whole system, not one per user, so this can be brisk.
# SELKIE_CLAIM_POLL_SECONDS=20

# Where the SQLite file lives. Defaults to .data/selkie.db at the repo root,
# which is gitignored. In production this MUST be on a disk that survives a
# restart (a Railway volume, not the container filesystem): it holds who
# everybody is and which handle owns which address.
# SELKIE_DB_PATH=/data/selkie.db
