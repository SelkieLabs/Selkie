# Selkie API. Copy to .env at the repo root; it is gitignored.
# Every value is read once at boot, so a missing one fails on start rather than
# in the middle of somebody's payment.

# --- Sign-in (Privy) ------------------------------------------------------
# Both come from the Privy dashboard: Settings > Basics.
# The secret authenticates Selkie to Privy. It is not the same thing as the app
# id, and it never belongs in the frontend.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- Stellar --------------------------------------------------------------
# Pays every fee and every account reserve, so no user ever needs XLM. Fund it
# on testnet at https://friendbot.stellar.org?addr=<its public address>.
# Whoever holds this secret can spend that account. Treat it like a bank card.
SELKIE_SPONSOR_SECRET=

# Attests logins to the escrow contract. Its only power is releasing money to
# the handle that proved it owns it, so it is the one key that must match what
# the deployed contract was told to trust.
SELKIE_ORACLE_SECRET=

# --- Storage --------------------------------------------------------------
# Postgres. Everything that has to outlive the process lives here: accounts,
# handles, activity, requests, and the sealed account keys.
#   createdb selkie && createdb selkie_test
DATABASE_URL=postgres://selkie@localhost:5432/selkie

# Seals account keys before they go in the database, so a dump or a backup is a
# set of rows rather than a set of spendable wallets. Format is
# `version:base64`, newest first, comma separated. Generate one with:
#   node -e "console.log('1:' + require('crypto').randomBytes(32).toString('base64'))"
SELKIE_WALLET_KEY=

# --- Optional -------------------------------------------------------------
# Lets the X and Telegram bots act for whoever messaged them. Leave it unset
# and that path does not exist at all, which is what you want if no bot runs:
# this secret can act as any user who has linked X or Telegram.
# SELKIE_BOT_SECRET=

# Only the tests read this. Point it at a throwaway database, never at the one
# above: each run creates and drops its own schema inside it. Unset, the
# storage tests skip rather than fail.
# DATABASE_URL_TEST=postgres://selkie@localhost:5432/selkie_test

# --- The X bot ------------------------------------------------------------
# The bot reads this same file. All four X keys or none: three of four fails at
# boot rather than later with an unhelpful 401. Polling X spends metered
# credits, so only run the bot when you mean to.
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=

# Works out every reply and posts none of them. On unless this is 0.
# SELKIE_BOT_DRY_RUN=1

# testnet (default) or public. Nothing else in the payment path branches on it.
SELKIE_NETWORK=testnet

# The escrow contract. Leave it unset and the API reads whatever
# contracts/deployments/<network>.env recorded at deploy time, which is what
# you want unless you are testing a contract you deployed yourself.
# SELKIE_HANDLE_ESCROW_ID=

# The port the API listens on. The web app expects 4000.
# PORT=4000
