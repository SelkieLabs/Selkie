# Selkie API. Copy to .env at the repo root; it is gitignored.
# Every value is read once at boot, so a missing one fails on start rather than
# in the middle of somebody's payment.

# --- Sign-in (Privy) ------------------------------------------------------
# Both come from the Privy dashboard: Settings > Basics.
# The secret authenticates Selkie to Privy. It is not the same thing as the app
# id, and it never belongs in the frontend.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- Stellar --------------------------------------------------------------
# Pays every fee and every account reserve, so no user ever needs XLM. Fund it
# on testnet at https://friendbot.stellar.org?addr=<its public address>.
# Whoever holds this secret can spend that account. Treat it like a bank card.
SELKIE_SPONSOR_SECRET=

# Attests logins to the escrow contract. Its only power is releasing money to
# the handle that proved it owns it, so it is the one key that must match what
# the deployed contract was told to trust.
SELKIE_ORACLE_SECRET=

# --- Storage --------------------------------------------------------------
# Postgres. Everything that has to outlive the process lives here: accounts,
# handles, activity, requests, and the sealed account keys.
#   createdb selkie && createdb selkie_test
DATABASE_URL=postgres://selkie@localhost:5432/selkie

# Seals account keys before they go in the database, so a dump or a backup is a
# set of rows rather than a set of spendable wallets. Format is
# `version:base64`, newest first, comma separated. Generate one with:
#   node -e "console.log('1:' + require('crypto').randomBytes(32).toString('base64'))"
SELKIE_WALLET_KEY=

# --- Optional -------------------------------------------------------------
# Lets the X and Telegram bots act for whoever messaged them. Leave it unset
# and that path does not exist at all, which is what you want if no bot runs:
# this secret can act as any user who has linked X or Telegram.
# SELKIE_BOT_SECRET=

# Only the tests read this. Point it at a throwaway database, never at the one
# above: each run creates and drops its own schema inside it. Unset, the
# storage tests skip rather than fail.
# DATABASE_URL_TEST=postgres://selkie@localhost:5432/selkie_test

# --- The X bot ------------------------------------------------------------
# The bot reads this same file. All four X keys or none: three of four fails at
# boot rather than later with an unhelpful 401. Polling X spends metered
# credits, so only run the bot when you mean to.
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=

# Works out every reply and posts none of them. On unless this is 0.
# SELKIE_BOT_DRY_RUN=1

# testnet (default) or public. Nothing else in the payment path branches on it.
SELKIE_NETWORK=testnet

# The escrow contract. Leave it unset and the API reads whatever
# contracts/deployments/<network>.env recorded at deploy time, which is what
# you want unless you are testing a contract you deployed yourself.
# SELKIE_HANDLE_ESCROW_ID=

# The port the API listens on. The web app expects 4000.
# PORT=4000

# ---------------------------------------------------------------------------
# NEAR mode (the NEAR HACKATHON build). Start the API with SELKIE_CHAIN=near.
# `npm run near:setup` creates the testnet accounts and appends the account
# names and keys below to .env for you; you only fill in the database.
# ---------------------------------------------------------------------------

# stellar (default) or near.
# SELKIE_CHAIN=near

# NEAR mode never shares the Stellar database: different users, addresses
# and feeds. Any empty Postgres database works; migrations run on start.
# NEAR_DATABASE_URL=postgres://selkie:selkie@localhost:5432/selkie_near

NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
# NEAR_EXPLORER_URL=https://explorer.testnet.near.org

# Root account; owns the rest. Its key is used only by the setup scripts.
NEAR_ROOT_ACCOUNT=selkiepay.testnet
# NEAR_ROOT_KEY=                       # secret

# Every handle account is created under this: amaka.x.selkiepay.testnet.
# Its key can create accounts; it never holds a key to the ones it creates.
NEAR_HANDLE_PARENT=x.selkiepay.testnet
# NEAR_HANDLE_PARENT_KEY=              # secret

# Pays the gas for actions users signed. Cannot change what they signed.
NEAR_RELAYER_ACCOUNT=relayer.selkiepay.testnet
# NEAR_RELAYER_KEY=                    # secret

# Releases escrowed money after a proven X login. Function-call key on
# escrow.claim only.
NEAR_ORACLE_ACCOUNT=oracle.selkiepay.testnet
# NEAR_ORACLE_KEY=                     # secret

# The handle-escrow contract (contracts-near/handle-escrow). Its key is only
# needed to deploy: npm run near:deploy-escrow.
NEAR_ESCROW_CONTRACT=escrow.selkiepay.testnet
# NEAR_ESCROW_KEY=                     # secret

# Circle's USDC on NEAR testnet (6 decimals). Mainnet: read it from 1Click
# /v0/tokens, never from memory.
NEAR_USDC_CONTRACT=3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af

# yoctoNEAR given to each new handle account for its own storage (0.01 NEAR).
# NEAR_NEW_ACCOUNT_DEPOSIT=10000000000000000000000

# How long held money waits before its sender may take it back (30 days).
# SELKIE_CLAIM_LIFETIME_SECS=2592000

# Optional. With it, held money waits for the X user id, not the username,
# so a renamed or re-registered handle cannot claim it.
# X_BEARER_TOKEN=

# NEAR Intents (1Click): add money from other chains, cash out to them.
# Mainnet only; on testnet the app shows dry quotes, labelled as previews.
# ONECLICK_API_URL=https://1click.chaindefuser.com
# Optional. Without a key from partners.near-intents.org, 1Click adds 0.25%.
# ONECLICK_JWT=                        # secret

# ---------------------------------------------------------------------------
# Web Push: tell people when money comes in, even with Selkie closed.
# Optional. `npm run push:keys` writes the pair to .env once; keep it, because
# browsers subscribe against the public key. Without it, money-in notices
# only show in an open tab.
# ---------------------------------------------------------------------------
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=                # secret
# How a push service contacts whoever runs this server (https: or mailto:).
# Defaults to SELKIE_WEB_URL.
# WEB_PUSH_SUBJECT=

# ---------------------------------------------------------------------------
# Email notices: an email when money comes in. Optional. People add and prove
# their address in Settings (X sign-in gives Selkie no email).
# ---------------------------------------------------------------------------
# Resend (resend.com). EMAIL_FROM must be on a domain verified in Resend; the
# test sender onboarding@resend.dev only delivers to your own Resend address.
# RESEND_API_KEY=                      # secret
# EMAIL_FROM=Selkie <notify@selkiepay.com>
# Local development without a provider: print each email in the API's console.
# EMAIL_DEV_LOG=1
# Where links in emails point. Defaults to SELKIE_WEB_URL.
# EMAIL_LINK_BASE_URL=http://localhost:3000
# Signs unsubscribe links. Defaults to a key derived from PRIVY_APP_SECRET.
# EMAIL_LINK_SECRET=                   # secret
