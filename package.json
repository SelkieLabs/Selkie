{
  "name": "selkie",
  "version": "0.1.0",
  "private": true,
  "description": "Selkie: send money to any social handle. Multi-chain payments, Stellar first.",
  "workspaces": [
    "packages/*",
    "frontend",
    "backend/*"
  ],
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev:web": "npm --workspace frontend run dev",
    "build:web": "npm --workspace frontend run build",
    "start:web": "npm --workspace frontend run start",
    "test": "tsx --env-file-if-exists=.env --test $(find packages backend -name '*.test.ts' -not -path '*/node_modules/*')",
    "db:migrate": "tsx --env-file-if-exists=.env backend/api/scripts/migrate.ts",
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/chain-stellar/tsconfig.json && tsc --noEmit -p backend/api/tsconfig.json && tsc --noEmit -p backend/bot/tsconfig.json && npm --workspace frontend run typecheck",
    "dev:api": "npm --workspace backend/api run dev",
    "dev:bot": "npm --workspace backend/bot run dev",
    "test:contracts": "cargo test --manifest-path contracts/Cargo.toml",
    "test:live": "tsx packages/chain-stellar/scripts/live-testnet.ts",
    "prove:restart": "tsx --env-file-if-exists=.env backend/api/scripts/prove-restart.ts",
    "near:setup": "tsx --env-file-if-exists=.env packages/chain-near/scripts/setup-testnet.ts",
    "near:setup:mainnet": "tsx --env-file-if-exists=.env.mainnet packages/chain-near/scripts/setup-mainnet.ts",
    "near:deploy-escrow": "tsx --env-file-if-exists=.env packages/chain-near/scripts/deploy-escrow.ts",
    "near:deploy-escrow:mainnet": "tsx --env-file=.env.mainnet packages/chain-near/scripts/deploy-escrow.ts",
    "push:keys": "tsx backend/api/scripts/push-keys.ts",
    "near:dao": "tsx --env-file-if-exists=.env packages/chain-near/scripts/dao-payout.ts",
    "near:rotate-oracle": "tsx --env-file-if-exists=.env packages/chain-near/scripts/rotate-oracle.ts",
    "near:lock-escrow": "tsx --env-file-if-exists=.env packages/chain-near/scripts/lock-escrow.ts",
    "near:deploy-pocket": "tsx --env-file-if-exists=.env packages/chain-near/scripts/deploy-pocket.ts",
    "build:contracts:near": "RUSTFLAGS='-C link-arg=-s --cfg near' cargo build --manifest-path contracts-near/Cargo.toml -p selkie-handle-escrow -p selkie-pocket --target wasm32-unknown-unknown --release",
    "test:contracts:near": "cargo test --manifest-path contracts-near/Cargo.toml",
    "prove:keys": "tsx packages/chain-near/scripts/prove-keys.ts",
    "test:live:near": "tsx --env-file-if-exists=.env packages/chain-near/scripts/live.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "tsx": "^4.23.1"
  }
}
