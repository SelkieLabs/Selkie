# Selkie web app. Copy to .env.local, which is gitignored.

# The Privy app id. Public by design: it ships in the browser bundle, which is
# why the app SECRET lives only in the API's .env and never here.
NEXT_PUBLIC_PRIVY_APP_ID=

# Where /api/* is rewritten to. Defaults to http://localhost:4000, so leave it
# alone in development and point it at the deployed API in production.
# SELKIE_API_ORIGIN=https://selkie-api-production.up.railway.app

# Which network the "view on explorer" links point at. `testnet` unless this
# says `public`. It has to match the API's SELKIE_NETWORK, or the links go to a
# page insisting the payment does not exist.
# NEXT_PUBLIC_SELKIE_NETWORK=testnet

# near (default on this branch) or stellar. Stellar features are hidden, not
# deleted, when this is near.
# NEXT_PUBLIC_SELKIE_CHAIN=near

# NEAR network for labels and the test-USDC faucet hint. testnet unless mainnet.
# NEXT_PUBLIC_NEAR_NETWORK=testnet

# NEAR explorer for transaction and account links.
# NEXT_PUBLIC_NEAR_EXPLORER=https://explorer.testnet.near.org
